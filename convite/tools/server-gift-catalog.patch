+app.post('/manager/invites/:id/gifts/catalog/bulk', requireManager, requireAdmin, asyncRoute(async (req, res) => {
+  const invite = await Invite.findById(req.params.id);
+  if (!invite) return res.status(404).json({ status: 'error', message: 'Convite não encontrado.' });
+  if (!requireMongoGiftCatalogWrite(invite, res)) return;
+
+  const parsed = parseGiftImportText(req.body?.text || req.body?.list || '');
+  if (!parsed.items.length) {
+    return res.status(400).json({ status: 'error', code: 'GIFT_IMPORT_EMPTY', message: 'A lista não contém presentes válidos.', data: parsed });
+  }
+  if (parsed.items.length > 500) {
+    return res.status(413).json({ status: 'error', code: 'GIFT_IMPORT_TOO_LARGE', message: 'Importe no máximo 500 presentes de cada vez.' });
+  }
+
+  const result = { inserted: 0, updated: 0, unchanged: 0, failed: [], duplicates: parsed.duplicates, invalid: parsed.invalid };
+
+  for (const item of parsed.items) {
+    try {
+      const existing = await findGiftItemByName(invite, item.name);
+      if (existing) {
+        const shouldUpdateCategory = item.category && item.category !== DEFAULT_GIFT_CATEGORY && item.category !== existing.category;
+        if (shouldUpdateCategory) {
+          existing.category = item.category;
+          existing.slug = invite.slug;
+          await existing.save();
+          result.updated += 1;
+        } else {
+          result.unchanged += 1;
+        }
+        continue;
+      }
+
+      await GiftItem.create({
+        inviteId: invite._id,
+        slug: invite.slug,
+        name: item.name,
+        category: item.category || DEFAULT_GIFT_CATEGORY,
+        reserved: false
+      });
+      result.inserted += 1;
+    } catch (err) {
+      if (err?.code === 11000) {
+        result.unchanged += 1;
+        continue;
+      }
+      result.failed.push({ name: item.name, message: err.message || 'Falha ao importar.' });
+    }
+  }
+
+  await logActivity({
+    invite,
+    type: 'gift',
+    title: 'Lista de presentes importada no AdminManager',
+    detail: `${result.inserted} novo(s) · ${result.updated} actualizado(s) · ${result.unchanged} existente(s) · ${result.failed.length} falha(s)`,
+    meta: { ...result, mode: 'mongo' }
+  });
+
+  return res.json({ status: 'success', message: 'Importação de presentes concluída.', data: result });
+}));
